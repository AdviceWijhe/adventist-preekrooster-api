APP_NAME="Preekrooster (TEST)"
APP_ENV=staging
APP_DEBUG=false
APP_URL=https://staging-api.preekrooster.adventist.nl
FRONTEND_URL=https://staging.preekrooster.adventist.nl

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null
LOG_DAILY_DAYS=14

# --- Database (staging) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=preekrooster_staging
DB_USERNAME=staging_user
DB_PASSWORD=change-me

# --- Mail ---
# Gebruik een echte SMTP of een catch-all zoals Mailtrap/Mailpit voor de testfase.
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-user
MAIL_PASSWORD=your-smtp-password
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Preekrooster (TEST)"

# --- Mail interceptor: VERPLICHT in de testfase ---
# Voorkomt dat er echte mails naar predikanten/gebruikers gaan.
# Alle uitgaande mail wordt omgeleid naar MAIL_INTERCEPT_ADDRESS.
MAIL_INTERCEPT_ENABLED=true
MAIL_INTERCEPT_ADDRESS=test-inbox@example.com
MAIL_INTERCEPT_SUBJECT_PREFIX="[TEST]"

# Keep 2FA enabled outside local development.
TWO_FACTOR_ENABLED=true

# Session hardening (ProductionConfigGuard eist dit op staging/production).
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true

# --- Datamigratie (oude database) ---
# Gebruikt door database/scripts/migrate_old_data.php en
# `php artisan migratie:analyse-gebruikers`.
OLD_DB_HOST=127.0.0.1
OLD_DB_PORT=3306
OLD_DB_DATABASE=advice0000_preekrooster
OLD_DB_USERNAME=root
OLD_DB_PASSWORD=

# Gebruikers die langer dan dit aantal maanden niet zijn ingelogd worden
# bij migratie als inactief gemarkeerd (niet verwijderd).
MIGRATIE_INACTIEF_MAANDEN=12
